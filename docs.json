{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Slowave",
  "description": "Living memory for your AI coding agents. Local, open source, no LLM API key.",
  "colors": {
    "primary": "#2F8F5B",
    "light": "#41C76C",
    "dark": "#2F6F4E"
  },
  "logo": {
    "light": "/images/slowave-logo.jpeg",
    "dark": "/images/slowave-logo.jpeg",
    "href": "/"
  },
  "favicon": "/images/slowave-icon.jpeg",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "decoration": "gradient"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": ["index", "why-slowave", "how-it-works"]
      },
      {
        "group": "Try it",
        "pages": ["quickstart", "see-it-work", "connect-your-agent"]
      },
      {
        "group": "Understand it",
        "pages": ["memory-model", "local-and-private", "compared-to-others"]
      },
      {
        "group": "Go further",
        "pages": ["use-cases", "reference-lite", "faq-and-troubleshooting"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/slowave-ai/slowave"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/slowave-ai/slowave"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Slowave Docs",
      "twitter:card": "summary_large_image"
    }
  },
  "redirects": [
    { "source": "/setup/installation", "destination": "/quickstart" },
    { "source": "/setup/client-integrations", "destination": "/connect-your-agent" },
    { "source": "/setup/services", "destination": "/reference-lite" },
    { "source": "/setup/removal", "destination": "/faq-and-troubleshooting" },
    { "source": "/guides/memory-lifecycle", "destination": "/memory-model" },
    { "source": "/guides/scopes", "destination": "/memory-model" },
    { "source": "/guides/procedures", "destination": "/memory-model" },
    { "source": "/guides/dashboard", "destination": "/see-it-work" },
    { "source": "/operations/cli-reference", "destination": "/reference-lite" },
    { "source": "/operations/backup-restore", "destination": "/reference-lite" },
    { "source": "/operations/configuration", "destination": "/reference-lite" },
    { "source": "/operations/troubleshooting", "destination": "/faq-and-troubleshooting" },
    { "source": "/reference/architecture", "destination": "/how-it-works" },
    { "source": "/reference/design", "destination": "/how-it-works" },
    { "source": "/reference/benchmarks", "destination": "/compared-to-others" },
    { "source": "/mcp/overview", "destination": "/reference-lite" },
    { "source": "/mcp/activate", "destination": "/reference-lite" },
    { "source": "/mcp/remember", "destination": "/reference-lite" },
    { "source": "/mcp/recall", "destination": "/reference-lite" },
    { "source": "/mcp/feedback", "destination": "/reference-lite" },
    { "source": "/mcp/commit", "destination": "/reference-lite" }
  ]
}
