{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Slowave",
  "description": "Living memory for your AI coding agents. Local, open source, no LLM API key.",
  "colors": {
    "primary": "#26794C",
    "light": "#41C76C",
    "dark": "#2F6F4E"
  },
  "logo": {
    "light": "/images/slowave-logo-light.png",
    "dark": "/images/slowave-logo-dark.png",
    "href": "/"
  },
  "favicon": "/images/favicon.png",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "decoration": "gradient"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "why-slowave",
          "quickstart",
          "see-it-in-action",
          "use-cases"
        ]
      },
      {
        "group": "How Slowave works",
        "pages": [
          "how-it-works",
          "memory-model",
          "procedures",
          "inspired-by-the-brain",
          "compared-to-others"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/overview",
          "integrations/claude-code",
          "integrations/copilot-cli",
          "integrations/codex",
          "integrations/cursor",
          "integrations/opencode",
          "integrations/windsurf",
          "integrations/cline",
          "integrations/claude-desktop"
        ]
      },
      {
        "group": "Your data and upkeep",
        "pages": [
          "local-and-private",
          "backup-and-restore",
          "uninstall"
        ]
      },
      {
        "group": "Help and reference",
        "pages": [
          "troubleshooting",
          "faq",
          "reference-lite"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/slowave-ai/slowave"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Quickstart",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/slowave-ai/slowave"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Slowave Docs",
      "twitter:card": "summary_large_image"
    }
  },
  "redirects": [
    {
      "source": "/setup/installation",
      "destination": "/quickstart"
    },
    {
      "source": "/setup/client-integrations",
      "destination": "/integrations/overview"
    },
    {
      "source": "/setup/services",
      "destination": "/reference-lite"
    },
    {
      "source": "/setup/removal",
      "destination": "/uninstall"
    },
    {
      "source": "/guides/memory-lifecycle",
      "destination": "/memory-model"
    },
    {
      "source": "/guides/scopes",
      "destination": "/memory-model"
    },
    {
      "source": "/guides/procedures",
      "destination": "/procedures"
    },
    {
      "source": "/guides/dashboard",
      "destination": "/see-it-in-action"
    },
    {
      "source": "/operations/cli-reference",
      "destination": "/reference-lite"
    },
    {
      "source": "/operations/backup-restore",
      "destination": "/backup-and-restore"
    },
    {
